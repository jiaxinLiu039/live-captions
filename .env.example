# Copy this file to .env and fill in your own keys.
# NEVER commit a real .env to git.

# Required — Aliyun Dashscope (realtime ASR)
DASHSCOPE_API_KEY=

# Required — DeepSeek (translation)
DEEPSEEK_API_KEY=

# Optional — if set, /ws requires ?token=<value>. Leave empty = no auth (insecure).
AUTH_TOKEN=

# Optional tuning (defaults shown)
# ASR_HOTWORD_WEIGHT=4
# ASR_HOTWORD_TIMEOUT=15
# MAX_SENTENCE_WORDS=25
# PROGRESSIVE_THRESHOLD=12
# PROGRESSIVE_INTERVAL=2
# PROGRESSIVE_EXTRA_WORDS=4
# ASR_COST_PER_SEC=0.00024
# TRANSLATE_COST_PER_SENTENCE=0.00002
